id: FS-05
descripcion: Render de overlays sin aplicar
cuando: 2026-10-22T20:57:50Z
comando: command -v kubectl >/dev/null || { echo 'kubectl no instalado'; exit 1; }; buscar -type f -path '*/overlays/*' \( -name kustomization.yaml -o -name kustomization.yml \) | while IFS= read -r f; do d=$(dirname "$f"); echo "### $d"; kubectl kustomize "$d" 2>&1 | sin_secretos | grep -E '^(apiVersion|kind|  name|  namespace)|image:|host:|type:|port:'; done
---salida---

---fin--- exit=0 estado=ok

