id: FS-10
descripcion: Repos clave de la plataforma clonados en la VM
cuando: 2026-10-22T20:57:51Z
comando: buscar -type d -name .git | while IFS= read -r d; do r=$(dirname "$d"); case "$(basename "$r")" in idp-colsubsidio|idp-colsubsidio-catalog|002-infraestructura-iac|003-platform-templates|005-templates-pipelines) echo "### $r"; printf 'rama: %s\n' "$(git -C "$r" branch --show-current 2>/dev/null)"; git -C "$r" log -1 --format='commit: %h %ci %s' 2>/dev/null;; esac; done
---salida---

---fin--- exit=0 estado=ok

==================================================
id: FS-11
descripcion: Ultimo cambio del overlay QA en git local
cuando: 2026-10-22T20:57:51Z
comando: buscar -type f -path '*/kubernetes/backstage/overlays/qa/kustomization.yaml' | while IFS= read -r f; do r=$(git -C "$(dirname "$f")" rev-parse --show-toplevel 2>/dev/null) || continue; echo "### $f"; git -C "$r" log -3 --format='%h %ci %s' -- "${f#$r/}"; done
---salida---

---fin--- exit=0 estado=ok

==================================================
id: FS-12
descripcion: Locations del catalogo en app-config (sin secretos)
cuando: 2026-10-22T20:57:51Z
comando: buscar -type f -name 'app-config*.yaml' -path '*idp-colsubsidio*' | while IFS= read -r f; do echo "### $f"; grep -E 'target:|type: url' "$f" | sed -E 's#(https?://)[^/@]+@#\1<credencial>@#'; done
---salida---

---fin--- exit=0 estado=ok

